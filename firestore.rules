rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /services/{serviceId} {
      allow read, write: if true;
    }

    match /plans/{planId} {
      allow read, write: if true;
    }

    match /settings/global {
      allow read, write: if true;
    }

    match /bookings/{bookingId} {
      allow read, write: if true;
    }

    match /admins/{uid} {
      allow read, write: if true;
    }
  }
}

